---
import Section from "./Section.astro";
import FutureLink from "./FutureLink.astro";
import { cases, srcset, size, viber, FUTURE } from "../data/site";
---
<Section id="cases" class="cases" rec="UX-R-004">
  <div class="container">
    <div class="cases__head">
      <h2>Кейси в квадратних метрах</h2>
      <p class="lead">Площа — головне в кожному кейсі: так видно масштаб робіт.</p>
    </div>

    <ol class="cases__list">
      {cases.map((c, i) => {
        const img = c.img ? size(c.img, 960) : null;
        return (
          <li class:list={["case", `case--${i + 1}`]}>
            <div class="case__text">
              <p class="case__area"><span class="nums">{c.area}</span><span class="case__unit">м²</span></p>
              <h3 class="case__object">{c.object}</h3>
              <p class="case__industry">{c.industry}</p>
              <p class="case__actions"><FutureLink note={FUTURE}>Детальніше про об'єкт</FutureLink><a class="text-link" href={viber}>Запитати про кейс у Viber</a></p>
            </div>
            {img && c.img && (
              <figure class="case__photo" data-reveal>
                <img src={img.src} srcset={srcset(c.img, [640, 960, 1300])} sizes="(max-width: 60rem) 100vw, 58vw" width={img.width} height={img.height} alt={c.alt} loading="lazy" decoding="async" data-rec="SP-R-002" />
              </figure>
            )}
          </li>
        );
      })}
    </ol>
    <p class="cases__all"><FutureLink note={FUTURE}>Усі проєкти</FutureLink></p>
  </div>
</Section>

<style>
  .cases { padding-block: var(--section-gap) var(--section-gap-band); }
  .cases__head { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); row-gap: var(--space-4); align-items: end; margin-bottom: var(--space-7); }
  .cases__head h2 { grid-column: 1 / 8; }
  .cases__head .lead { grid-column: 8 / 13; }

  .cases__list { list-style: none; display: grid; gap: var(--space-8); }
  .case { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); align-items: center; border-top: var(--line-strong) solid var(--color-text); padding-top: var(--space-5); }
  .case__text { display: grid; gap: var(--space-2); justify-items: start; align-content: start; }
  .case__area { font-family: var(--font-display); font-weight: var(--weight-display); font-size: var(--text-area); line-height: .9; letter-spacing: -0.035em; display: flex; align-items: baseline; gap: .12em; white-space: nowrap; }
  .case__unit { font-size: .42em; letter-spacing: -0.01em; }
  .case__object { font-size: var(--text-title); margin-top: var(--space-3); }
  .case__industry { color: var(--color-text-muted); }
  .case__actions { margin-top: var(--space-3); display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-5); font-size: var(--text-sm); font-weight: var(--weight-strong); }
  .case__actions > * { min-height: 44px; display: inline-flex; align-items: center; }

  /* Row 1: the biggest figure across the width, no photo (the hero already shows this shop). */
  .case--1 .case__text { grid-column: 1 / 13; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); align-items: end; }
  .case--1 .case__area { grid-column: 1 / 8; grid-row: 1 / 5; align-self: end; font-size: clamp(4rem, 1.5rem + 10vw, 11rem); }
  .case--1 .case__object, .case--1 .case__industry, .case--1 .case__actions { grid-column: 9 / 13; }
  /* Rows 2 and 3: 7/5, then 5/7 mirrored once. */
  .case--2 .case__photo { grid-column: 1 / 8; grid-row: 1; }
  .case--2 .case__text { grid-column: 9 / 13; grid-row: 1; }
  .case--3 .case__text { grid-column: 1 / 5; grid-row: 1; }
  .case--3 .case__photo { grid-column: 6 / 13; grid-row: 1; }
  .case--2 .case__area, .case--3 .case__area { font-size: clamp(3.5rem, 1.5rem + 5vw, 6.5rem); }

  .case__photo { overflow: hidden; background: var(--color-surface); }
  .case__photo img { width: 100%; aspect-ratio: 5 / 4; object-fit: cover; }
  /* Effect 3: the photo opens from the bottom up, like a pour. clip-path sits on the <img>, never on the observed figure. */
  :global(.js) .case__photo img { clip-path: inset(100% 0 0 0); transition: clip-path var(--dur-long) var(--ease-out); }
  :global(.js) .case__photo:global(.is-visible) img { clip-path: inset(0 0 0 0); }

  .cases__all { margin-top: var(--space-5); padding-top: var(--space-4); border-top: var(--line) solid var(--color-rule); font-weight: var(--weight-strong); text-align: right; }

  @media (max-width: 60rem) {
    .cases__head h2, .cases__head .lead { grid-column: 1 / 13; }
    .case { row-gap: var(--space-5); }
    .case--1 .case__area, .case--1 .case__object, .case--1 .case__industry, .case--1 .case__actions { grid-column: 1 / 13; grid-row: auto; }
    .case--2 .case__photo, .case--2 .case__text, .case--3 .case__photo, .case--3 .case__text { grid-column: 1 / 13; grid-row: auto; }
    .case--3 .case__photo { order: 2; }
  }
  @media (max-width: 40rem) {
    .cases__list { gap: var(--space-7); }
    .cases__head { margin-bottom: var(--space-6); }
    :global(.js) .case__photo img { transition-duration: 450ms; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .case__photo img { clip-path: none; transition: none; }
  }
</style>
