---
import Section from "./Section.astro";
import FutureLink from "./FutureLink.astro";
import { steps, pluses, srcset, size, FUTURE } from "../data/site";
const img = size("process", 800);
---
<Section id="process" class="process on-field" rec="UX-R-008">
  <div class="container">
    <div class="process__top">
      <div class="process__head">
        <h2>Цех працює, поки ми кладемо підлогу</h2>
        <p class="process__accents">
          <span class="process__accent">Роботи без зупинки виробництва.</span>
          <span class="process__accent process__accent--signal">Повне навантаження через 4 години.</span>
        </p>
      </div>
      <figure class="process__photo">
        <img src={img.src} srcset={srcset("process", [800, 1351])} sizes="(max-width: 60rem) 100vw, 42vw" width={img.width} height={img.height} alt="Мокра світла підлога в проході між ємностями виробничого цеху" loading="lazy" decoding="async" data-rec="SP-R-002" />
      </figure>
    </div>

    <ol class="steps" data-reveal aria-label="Повний цикл робіт">
      {steps.map((s, i) => <li class="step" style={`--i:${i}`}><span class="step__title">{s}</span></li>)}
    </ol>

    <ul class="pluses">
      {pluses.map((p) => <li><strong>{p.title}</strong> <span>{p.text}</span></li>)}
    </ul>
    <p class="process__more"><FutureLink note={FUTURE}>Як ми працюємо: процес і гарантія</FutureLink></p>
  </div>
</Section>

<style>
  .process { background: var(--color-field); color: var(--color-on-field); padding-block: var(--section-gap) var(--section-gap); }
  .process__top { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); row-gap: var(--space-6); align-items: center; }
  .process__head { grid-column: 1 / 7; display: grid; gap: var(--space-5); }
  .process__accents { display: grid; gap: var(--space-2); font-size: var(--text-lead); font-weight: var(--weight-strong); line-height: 1.35; }
  .process__accent--signal { color: var(--color-accent); }
  .process__photo { grid-column: 8 / 13; }
  .process__photo img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; object-position: 30% 60%; background: var(--color-rule-dark); }

  /* Steps: a real <ol> on a line. Effect 4: the line draws, the numerals follow one by one. */
  .steps { list-style: none; counter-reset: step; position: relative; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); column-gap: var(--gap); margin-top: var(--space-8); padding-top: var(--space-6); }
  .steps::before { content: ""; position: absolute; left: 0; right: 0; top: 0; height: var(--line-strong); background: var(--color-on-field-muted); transform-origin: left; }
  .step { counter-increment: step; position: relative; display: grid; gap: var(--space-3); align-content: start; }
  .step::before { content: counter(step); font-family: var(--font-display); font-weight: var(--weight-display); font-size: var(--text-section); line-height: 1; color: var(--color-on-field); }
  .step::after { content: ""; position: absolute; left: 0; top: calc(var(--space-6) * -1 - 5px); width: 12px; height: 12px; background: var(--color-on-field); }
  .step:last-child::after { background: var(--color-accent); }
  .step__title { font-size: var(--text-md); font-weight: var(--weight-strong); line-height: 1.35; max-width: 16ch; }

  .pluses { list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: var(--gap); margin-top: var(--space-8); border-top: var(--line) solid var(--color-rule-dark); }
  .pluses li { padding-top: var(--space-5); display: grid; align-content: start; gap: var(--space-1); color: var(--color-on-field-muted); }
  .pluses strong { color: var(--color-on-field); font-size: var(--text-lead); font-weight: var(--weight-strong); }
  .process__more { margin-top: var(--space-6); font-weight: var(--weight-strong); }
  .process__more :global(.future-link) { text-decoration-color: var(--color-on-field-muted); }

  @media (max-width: 60rem) {
    .process__head, .process__photo { grid-column: 1 / 13; }
    .steps { grid-template-columns: minmax(0, 1fr); row-gap: var(--space-5); padding-top: 0; padding-left: var(--space-6); margin-top: var(--space-7); }
    .steps::before { left: 5px; right: auto; top: 6px; bottom: 6px; width: var(--line-strong); height: auto; transform-origin: top; }
    .step { grid-template-columns: auto minmax(0, 1fr); align-items: baseline; column-gap: var(--space-4); }
    .step::before { font-size: var(--text-title); }
    .step::after { left: calc(var(--space-6) * -1); top: 8px; }
    .step__title { max-width: none; }
    .pluses { grid-template-columns: minmax(0, 1fr); margin-top: var(--space-7); }
  }
</style>
