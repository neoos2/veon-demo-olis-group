---
import Section from "./Section.astro";
import FutureLink from "./FutureLink.astro";
import { checklist, phones, viber, telegram, email, mailtoEstimate, address, mapUrl, hours, FUTURE } from "../data/site";
---
<Section id="estimate" class="est" rec="UX-R-005">
  <div class="container est__grid">
    <div class="est__left">
      <h2>Сім пунктів для точного кошторису</h2>
      <p class="lead">Ціну рахуємо під об'єкт, онлайн-калькулятора немає. Надішліть ці дані, і ми зробимо попередній розрахунок. Мінімальне замовлення — від 300 м².</p>
      <ol class="check">
        {checklist.map((c) => <li><strong>{c.title}</strong> <span>{c.text}</span></li>)}
      </ol>
      <p class="est__tz"><FutureLink note={FUTURE}>Технічне завдання онлайн</FutureLink></p>
    </div>

    <div class="est__right" data-rec="UX-R-002">
      <div class="ch">
        <h3 class="ch__h">Надіслати дані</h3>
        <a class="btn btn--primary ch__mail" href={mailtoEstimate}>Написати на e-mail</a>
        <p class="ch__email"><a class="text-link" href={`mailto:${email}`}>{email}</a></p>
        <p class="muted ch__note">Лист відкриється з готовим шаблоном: заповніть пункти і додайте фото основи.</p>
      </div>
      <div class="ch">
        <h3 class="ch__h">Подзвонити</h3>
        <ul class="ch__phones">
          {phones.map((p) => <li><a class="ch__phone nums" href={`tel:${p.tel}`}>{p.label}</a></li>)}
        </ul>
      </div>
      <div class="ch">
        <h3 class="ch__h">Написати в месенджер</h3>
        <div class="ch__msgs">
          <a class="btn btn--outline" href={viber}>Viber</a>
          <a class="btn btn--outline" href={telegram}>Telegram</a>
        </div>
      </div>
      <div class="ch ch--addr">
        <h3 class="ch__h">Приходьте в офіс</h3>
        <address>{address.postal}, м. {address.city}, {address.street}</address>
        <p class="muted">{hours}</p>
        <a class="text-link" href={mapUrl} target="_blank" rel="noopener">Відкрити на карті<span class="visually-hidden"> (відкриється в новій вкладці)</span></a>
      </div>
    </div>
  </div>
</Section>

<style>
  .est { background: var(--color-surface); padding-block: var(--section-gap) var(--section-gap); }
  .est__grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); row-gap: var(--space-7); align-items: start; }
  .est__left { grid-column: 1 / 7; display: grid; gap: var(--space-5); }
  .check { list-style: none; counter-reset: c; border-top: var(--line-strong) solid var(--color-text); margin-top: var(--space-3); }
  .check li { counter-increment: c; display: grid; grid-template-columns: 2.5rem minmax(0, 1fr); column-gap: var(--space-3); padding-block: var(--space-3); border-bottom: var(--line) solid var(--color-rule); }
  .check li::before { content: counter(c); grid-row: 1 / 3; font-family: var(--font-display); font-weight: var(--weight-display); font-size: var(--text-title); line-height: 1; color: var(--color-primary); }
  .check strong { font-weight: var(--weight-strong); font-size: var(--text-lead); line-height: 1.3; }
  .check span { color: var(--color-text-muted); font-size: var(--text-sm); }
  .est__tz { font-weight: var(--weight-strong); }

  .est__right { grid-column: 8 / 13; display: grid; gap: var(--space-6); }
  .ch { display: grid; gap: var(--space-3); justify-items: start; padding-top: var(--space-4); border-top: var(--line) solid var(--color-border); }
  .ch__h { font-size: var(--text-md); color: var(--color-text-muted); font-weight: var(--weight-strong); }
  .ch__mail { min-height: var(--control-h); }
  .ch__email { font-size: var(--text-lead); overflow-wrap: anywhere; }
  .ch__note { font-size: var(--text-sm); }
  .ch__phones { list-style: none; display: grid; width: 100%; }
  .ch__phones li { display: flex; align-items: center; gap: var(--space-3); padding-block: var(--space-2); }
  /* A visible separator between neighbouring numbers. */
  .ch__phones li + li { border-top: var(--line) solid var(--color-rule); }
  .ch__phone { font-family: var(--font-display); font-weight: var(--weight-display); font-size: var(--text-title); text-decoration: none; letter-spacing: -0.01em; min-height: 44px; display: inline-flex; align-items: center; white-space: nowrap; transition: color var(--dur-micro) var(--ease-out); }
  @media (hover: hover) { .ch__phone:hover { color: var(--color-primary); } }
  .ch__main { font-size: var(--text-xs); font-weight: var(--weight-strong); background: var(--color-accent); color: var(--color-accent-ink); padding: 2px var(--space-2); border-radius: var(--radius); }
  .ch__msgs { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .ch--addr address { font-style: normal; }

  @media (max-width: 60rem) {
    .est__left, .est__right { grid-column: 1 / 13; }
  }
  @media (max-width: 40rem) {
    .ch__mail { width: 100%; }
    .ch__msgs { display: grid; grid-template-columns: 1fr 1fr; width: 100%; }
    .ch__phone { font-size: var(--text-lead); }
  }
</style>
