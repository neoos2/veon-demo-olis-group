---
import Section from "./Section.astro";
import FutureLink from "./FutureLink.astro";
import { industries, srcset, size, viber, FUTURE } from "../data/site";
---
<Section id="industries" class="ind" rec="UX-R-003">
  <div class="container">
    <div class="ind__head">
      <h2>Оберіть своє виробництво</h2>
      <p class="lead">Дев'ять галузей, для яких ми вже будували підлоги. У кожній — об'єкт, де підлога працює.</p>
    </div>

    <div class="ind__body" data-tabs>
      <p class="ind__hint" aria-hidden="true">Гортайте вбік: усі 9 галузей</p>
      <div class="ind__tabs" role="tablist" aria-label="Галузі" aria-orientation="vertical">
        {industries.map((it, i) => (
          <button class="ind__tab" type="button" role="tab" id={`tab-${it.id}`} aria-controls={`panel-${it.id}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>
            {it.name}
          </button>
        ))}
        <span class="ind__marker" data-marker aria-hidden="true"></span>
      </div>

      <div class="ind__panels">
        {industries.map((it, i) => {
          const base = size(it.img, it.widths[Math.min(1, it.widths.length - 1)]);
          return (
            <article class="ind__panel" id={`panel-${it.id}`} role="tabpanel" aria-labelledby={`tab-${it.id}`} tabindex="0">
              <figure class="ind__photo">
                <img src={base.src} srcset={srcset(it.img, [...it.widths])} sizes="(max-width: 60rem) 100vw, 55vw" width={base.width} height={base.height} alt={it.alt} loading="lazy" decoding="async" data-rec="SP-R-002" />
              </figure>
              <div class="ind__meta">
                <p class="ind__industry">{it.name}</p>
                <h3 class="ind__object">{it.object}</h3>
                {it.count && <p class="ind__count"><span class="nums">{it.count}</span> кейсів галузі в розділі «Проєкти»</p>}
                <p class="ind__actions"><FutureLink note={FUTURE}>Усі кейси галузі</FutureLink><a class="text-link" href={viber}>Запитати про кейс у Viber</a></p>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </div>
</Section>

<style>
  .ind { padding-block: var(--section-gap-l) var(--section-gap); }
  .ind__head { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); row-gap: var(--space-4); align-items: end; margin-bottom: var(--space-7); }
  .ind__head h2 { grid-column: 1 / 7; }
  .ind__head .lead { grid-column: 8 / 13; }

  .ind__body { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); align-items: start; }
  .ind__tabs { grid-column: 1 / 7; position: relative; display: flex; flex-direction: column; border-top: var(--line) solid var(--color-rule); }
  .ind__tab {
    appearance: none; background: none; border: 0; border-bottom: var(--line) solid var(--color-rule);
    text-align: left; cursor: pointer; color: var(--color-text-muted);
    font: var(--weight-display) clamp(1.0625rem, 0.55rem + 0.95vw, 1.3125rem)/1.2 var(--font-display); letter-spacing: -0.01em; white-space: nowrap;
    padding: var(--space-4) var(--space-4) var(--space-4) var(--space-5); min-height: 60px;
    transition: color var(--dur-micro) var(--ease-out), background-color var(--dur-micro) var(--ease-out);
  }
  .ind__tab[aria-selected="true"] { color: var(--color-text); }
  @media (hover: hover) { .ind__tab:hover { color: var(--color-text); background: var(--color-surface); } }
  .ind__tab:focus-visible { outline-offset: -2px; }
  /* Effect 2: the orange marker slides to the chosen industry (transform only). */
  .ind__marker { display: none; position: absolute; left: 0; top: 0; width: 4px; height: 1px; background: var(--color-accent); transform-origin: 0 0; transition: transform var(--dur-short) var(--ease-out); pointer-events: none; }
  .ind__marker[data-axis="x"] { width: 1px; height: 4px; top: auto; bottom: 0; }
  :global(.is-tabs) .ind__marker { display: block; }
  /* Without the script there are no tabs: every industry is shown as a plain list of panels. */
  :global(html:not(.js)) .ind__tabs { display: none; }
  :global(html:not(.js)) .ind__panels { grid-column: 1 / 13; position: static; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-7) var(--gap); }

  .ind__panels { grid-column: 8 / 13; position: sticky; top: calc(var(--header-h) + var(--space-5)); display: grid; gap: var(--space-7); }
  .ind__panel { display: grid; gap: var(--space-5); border-radius: var(--radius); }
  .ind__panel[hidden] { display: none; }
  .ind__panel:not([hidden]) { animation: panel-in var(--dur-short) var(--ease-out); }
  @keyframes panel-in { from { opacity: 0; } to { opacity: 1; } }
  .ind__photo img { width: 100%; aspect-ratio: 960 / 560; object-fit: cover; background: var(--color-surface); }
  .ind__meta { display: grid; gap: var(--space-2); justify-items: start; }
  .ind__industry { font-size: var(--text-sm); color: var(--color-text-muted); }
  .ind__object { font-size: var(--text-title); }
  .ind__count { color: var(--color-text); }
  .ind__count .nums { font-family: var(--font-display); font-weight: var(--weight-display); }
  .ind__actions { margin-top: var(--space-2); display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-5); font-size: var(--text-sm); font-weight: var(--weight-strong); }
  .ind__actions > * { min-height: 44px; display: inline-flex; align-items: center; }
  .ind__hint { display: none; }

  @media (max-width: 60rem) {
    .ind__head h2, .ind__head .lead { grid-column: 1 / 13; }
    .ind__head { margin-bottom: var(--space-6); }
    .ind__body { display: block; }
    :global(.is-tabs) .ind__tabs {
      flex-direction: row; overflow-x: auto; scroll-snap-type: x proximity; scrollbar-width: none;
      border-top: 0; border-bottom: var(--line) solid var(--color-rule); margin-inline: calc(var(--space) * -1); padding-inline: var(--space);
    }
    :global(.is-tabs) .ind__tabs::-webkit-scrollbar { display: none; }
    /* Scroll cue: the strip fades at the right edge and a short hint says it scrolls. */
    :global(.is-tabs) .ind__tabs { -webkit-mask-image: linear-gradient(to right, var(--color-text) 80%, transparent); mask-image: linear-gradient(to right, var(--color-text) 80%, transparent); }
    :global(.is-tabs) .ind__hint { display: block; font-size: var(--text-sm); color: var(--color-text-muted); margin-bottom: var(--space-2); }
    :global(.is-tabs) .ind__tab { flex: none; border-bottom: 0; white-space: nowrap; font-size: var(--text-md); padding: var(--space-3) var(--space-4); scroll-snap-align: start; min-height: 48px; }
    :global(html:not(.js)) .ind__panels { grid-template-columns: minmax(0, 1fr); }
    .ind__panels { position: static; margin-top: var(--space-5); }
  }
</style>
